# ── 서버 ────────────────────────────────────────────────
PORT=8080
PUBLIC_URL=http://dev.lvly.io:8080
LOG_LEVEL=info

# ── 인증 (1단계: 퍼유저 bearer) ──────────────────────────
# 데모용 정적 토큰 테이블. 운영에서는 이 테이블을 DB/IdP 로 옮기고,
# 2단계에서 src/auth/bearer.ts 를 OAuth(jose) 검증으로 교체하세요.
# 형식: { "<token>": { userId, email, scopes[], projects[] } }
#   scopes:   memory | context | code | db  (접근 가능한 capability)
#             db 는 모든 데이터소스 허용(후방호환). 'db:<source>' 로 특정 소스만 허용도 가능(DB_SOURCES_JSON 참조).
#   projects: 접근 가능한 프로젝트 슬러그, "*" = 전체
# 토큰은 반드시 고엔트로피 랜덤으로 생성할 것: openssl rand -hex 32
# (사람이 추측 가능한 문자열 금지 — 이 토큰이 게이트웨이 뒤 전체 쓰기 표면의 유일한 인증층이다.)
AUTH_TOKENS_JSON={"<openssl-rand-hex-32-A>":{"userId":"yoon","email":"yoon@lively.kr","scopes":["context","db","items"],"projects":["*"]},"<openssl-rand-hex-32-B>":{"userId":"jang","email":"jang@lively.kr","scopes":["context","db","items"],"projects":["core"]}}

# ── DB (반드시 읽기 전용 리플리카 + 읽기 전용 role) ───────
# db_query/db_schema 가 읽는 '데이터소스'. DATABASE_URL 은 기본 소스('default')로 자동 등록된다.
DATABASE_URL=postgres://mcp_readonly@db-replica.internal:5432/app
DB_STATEMENT_TIMEOUT_MS=5000
DB_MAX_ROWS=1000
# 여러 운영 DB 를 읽으려면 명명 소스를 추가한다(전부 읽기전용 리플리카+role 전제, 1차 pg-only).
#   rls: SET LOCAL <GUC>=<userId> 로 주입할 GUC 이름(행수준 격리). 키를 빼면 행수준 격리 없음(테이블수준만).
#   maxRows/timeoutMs: 소스별 오버라이드(미지정 시 위 DB_MAX_ROWS/DB_STATEMENT_TIMEOUT_MS).
# db_query 는 source 인자로 소스를 고른다(소스 2개↑이고 default 없으면 source 명시 필수). db_sources 로 목록 확인.
# DB_SOURCES_JSON={"ops":{"url":"postgres://ro@db-replica.internal/lively","rls":"app.current_user"},"analytics":{"url":"postgres://ro@warehouse.internal/dw","rls":null,"maxRows":5000}}

# ── Item store (크로스소스 활동: Slack/Discord/Notion) ───
ITEMS_DATABASE_URL=postgres://items:itemspw@items-db.internal:5432/items
# 커넥터 토큰 — 관리탭(커넥터 설정 탭)에서 넣거나 여기 .env 에 둔다. 관리탭(DB) 우선, 없으면 이 env 로 폴백(#541).
#   관리탭에서 토큰을 저장하려면 아래 CONNECTOR_SECRET_KEY 가 필요(암호화 저장). SSM 전용 박스처럼 .env 편집이
#   어려운 배포에 유용 — 웹 관리탭에서 토큰을 설정하면 게이트웨이 키로 암호화돼 org_connector 에 저장된다.
#   ⚠ CONNECTOR_SECRET_KEY 를 잃거나 바꾸면 기존 암호문은 복호화 불가(토큰 재입력) — .env 볼륨과 함께 보존.
#   미설정이면 관리탭 토큰 저장은 비활성(안내 배너 표시), 아래 env 토큰으로 폴백해 종전과 동일 동작.
#   (#540) git 자격(SSH키·HTTPS 토큰)의 DB 봉투암호화도 이 키를 공용으로 쓴다. deploy(install/update.sh)가 자동 생성·보존.
CONNECTOR_SECRET_KEY=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
NOTION_TOKEN=
# ClickUp personal token (run-sync/pm_* 쓰기 — Authorization: <token>, Bearer 접두사 없음)
CLICKUP_API_TOKEN=
# ClickUp 싱크 제외 리스트(샘플/노이즈 리스트 id, 쉼표구분)
CLICKUP_EXCLUDE_LIST_IDS=
# ClickUp 싱크 허용 리스트(설정 시 이 리스트만 싱크 — 컨테이너 스코핑). 우리 모델: 컨테이너 List 의 top-level Task=project.
# 예) "Lively 프로젝트" 컨테이너 한정: 901819043608
CLICKUP_INCLUDE_LIST_IDS=
# ClickUp 아웃바운드 컨테이너 리스트 id — 로컬 신규 project 를 이 List 안에 top-level Task 로 생성(#177 #6b run-push).
# 보통 CLICKUP_INCLUDE_LIST_IDS 와 동일. 예) 901819043608
CLICKUP_CONTAINER_LIST_ID=
# Gmail / Google Drive — OAuth2 refresh-token(#541). 각자 GCP 프로젝트에서 OAuth 클라이언트(Desktop/Installed 유형)
#   발급 → consent 후 client_id/client_secret/refresh_token 획득. 1개 refresh token 이 여러 scope 커버 가능
#   (gmail.readonly / drive.readonly). ⚠ OAuth 클라이언트가 "Testing" 상태면 refresh token 7일 만료 → consent 화면 publish.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Gmail 검색식(선택) — 예: "-from:noreply -category:promotions". 비우면 전체(증분 시 after: 시간바운드만).
GMAIL_QUERY=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Drive 폴더 id 제한(선택, 쉼표구분) — 비우면 전체 Drive(공유 드라이브 포함).
GDRIVE_FOLDERS=

# ── domainmap (canonical 도메인/프로젝트/부채 맵) ────────
# Stage⑥: 엔진이 게이트웨이에 흡수됨(src/domainmap/) — 별도 서비스/프록시 없음.
# 엔진 전용 DB 접속 문자열(쓰기 가능). 게이트웨이 DATABASE_URL(읽기전용 리플리카)과 절대 혼용 금지.
DOMAINMAP_DATABASE_URL=postgres://domainmap:dmpw@items-db.internal:5432/domainmap
# repo 인자 생략 시 사용할 기본 레포 이름(선택)
DOMAINMAP_DEFAULT_REPO=
# 웹훅(POST /api/webhook/{github,gitlab}) HMAC secret — 미설정이면 503 fail-closed.
WEBHOOK_SECRET=
# 커넥터 싱크/도메인 authoring 이 절대 쓰면 안 되는 보호 리포(콤마 구분, 기본 lively)
SYNC_BLOCKED_REPOS=lively
# 웹훅 push-refresh 용 git 클론 캐시 디렉(게이트웨이 작업 디렉 기준, .gitignore 등재)
DOMAINMAP_REPOS_DIR=var/repos

# ── item→domain/project 매핑 (D2/P3 컨테이너맵) ──────────
# 매핑 쓰기 툴(list_unmapped/mapping_candidates/propose_item_domain/propose_item_project)은
# 기존 'items' 스코프를 재사용한다(위 dev 토큰이 이미 items 부여 → 별도 토큰 마이그레이션 불필요).
# 컨테이너(채널/DB/페이지)→도메인/프로젝트 맵. 코드 변경 없이 큐레이션. 키 = "<prov_system>:<container_ref>".
# 미설정이면 컨테이너맵 비활성(현재 '#회의' 채널은 잡담이라 의도적으로 미매핑).
# MAPPING_CONTAINER_JSON={"domain":{"discord:1471507104052281365":["campaigns"]},"project":{"discord:1471507104052281365":["explore-feed"]}}

# ── 임베딩 / 벡터·하이브리드 검색 (#172, 선택 — 기본 off) ────
# knowledge_search(의미·자연어 하이브리드)용. off 면 knowledge_search 는 grep(렉시컬)으로 자동 폴백 → 무중단.
# 켜는 법:
#   1) EMBEDDINGS_PROVIDER=http 로 변경
#   2) `docker compose --profile embeddings up -d`  (Ollama 사이드카 기동 + bge-m3 자동 pull)
#   3) `npm run build && node --env-file-if-exists=.env scripts/backfill-embeddings.mjs`  (기존 지식 임베딩)
#   ⚠ items DB(ITEMS_DATABASE_URL)에 **pgvector 확장** 필요(부팅 시 CREATE EXTENSION 시도, 권한 없으면 grep 폴백).
# 모델 스왑(고객 자유): EMBEDDINGS_MODEL 변경 + `docker compose exec embeddings ollama pull <model>`.
#   차원이 다르면 EMBEDDINGS_DIMENSIONS 도 바꾸고 `backfill-embeddings.mjs --all` 로 재임베딩.
# 외부 엔드포인트(OpenAI/자체 vLLM·TEI 등): EMBEDDINGS_BASE_URL 을 그쪽 host 로(경로 /v1/embeddings 자동 부착),
#   인증 필요하면 EMBEDDINGS_AUTH_ENV 에 **키를 담은 환경변수 '이름'**(키 값 자체 아님)을 지정.
EMBEDDINGS_PROVIDER=off
EMBEDDINGS_BASE_URL=http://embeddings:11434
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_DIMENSIONS=1024
# EMBEDDINGS_AUTH_ENV=OPENAI_API_KEY

# ── 2단계 OAuth (나중에) ─────────────────────────────────
# OAUTH_ISSUER=https://accounts.google.com
# OAUTH_AUDIENCE=context-ontology
