# ─────────────────────────────────────────────────────────────────────────────
# 중앙 박스 구성원 격리(#524) — 게이트웨이 서비스 유저의 **최소** 권한 (2가지, 각각 root 소유 고정 스크립트만).
#
#  ① 세션 spawn: 세션 셸/하네스를 box_members 그룹의 그 멤버로 내림(자격증명 uid 격리의 핵심).
#  ② 웹 프로비저닝(#524): 관리자 버튼이 게이트웨이를 통해 멤버 OS 유저를 만든다(useradd 등 root 필요).
#
#  둘 다 **root 소유·게이트웨이 비쓰기 고정 스크립트**(/opt/lively/libexec/*)만 허용 — 게이트웨이가 스크립트를
#  못 고치므로 "그 스크립트가 하는 일" 외 임의 root 실행 불가. 토큰 등 비밀은 env_keep 으로만 전달(PATH 미보존
#  → secure_path 라 PATH 인젝션 없음). 멤버 추가는 box_members 그룹 가입만으로 되고 이 파일은 무수정.
#
#  ⚠ 설치(install-isolation.sh 가 수행): /etc/sudoers.d/lively (root:root 0440), `visudo -cf` 검증 후 활성.
#     'lively' 주체는 install-isolation.sh 가 실제 게이트웨이 유저로 치환(sed). box-spawn·provision-member 는
#     root:root 0755. box-spawn 헤더의 불변식 참조.
#  ⚠ ①=uid 격리, ②=웹 프로비저닝 편의. ssm-user NOPASSWD 회수·게이트웨이 docker 그룹 제거·전용 서비스 유저는
#     별도 하드닝 런북(P4).
# ─────────────────────────────────────────────────────────────────────────────

Runas_Alias LIVELY_BOX_MEMBERS = %box_members
# ③ 브로커 spawn(#746 T4) — broker_members 로 같은 wrapper 하나만. 멤버 대화 uid(box_*)와 분리된 전용 uid.
Runas_Alias LIVELY_BROKERS = %broker_members

# ① 세션 spawn + ③ 브로커 spawn(#746 T4) — box_members·broker_members 로 wrapper 하나만, 비밀번호 없이.
lively ALL=(LIVELY_BOX_MEMBERS,LIVELY_BROKERS) NOPASSWD: /opt/lively/libexec/box-spawn
# env_keep(sudo env_reset 우회): TZ 보존(#778 — 조직 시간대를 격리 세션 셸/클로드에 전달, 비밀 아님·권한확대 아님) +
#  LIVELY_SESSION_ID(#852 — 이 pane 이 어느 터미널 세션인지. 하네스가 MCP 헤더로 되보내 게이트웨이가 작업의 세션을
#   자동 기록한다. 세션 id 는 게이트웨이가 만든 공개 식별자라 비밀 아님·권한확대 아님 — 입장 권한은 게이트웨이가 따로 본다) +
#  LIVELY_MODE(#1007+ — 이 세션의 실행 모드 readonly|incognito. 하네스가 MCP 헤더 x-lively-mode 로 되보내 게이트웨이가 이 세션의
#   쓰기 툴 소거(readonly)/전체 차단(incognito)을 강제한다. **권한을 넓히는 게 아니라 좁히는** 플래그라 보존해도 안전 — 미보존이면 격리 세션에서 모드가 안 걸릴 뿐)
#   + LIVELY_OFF(incognito 세션이 훅까지 끄는 플래그. 역시 좁히는 방향)
#   + 구 LIVELY_READONLY/LIVELY_INCOGNITO(전이기 dual-env — createSession 이 x-lively-mode 헤더 미전파 박스를 위해 구 env 도 함께 세팅한다.
#     격리 sudo 분기는 env_reset 이라 여기서 보존 안 하면 그 박스에서 구 헤더가 빈 값으로 확장→모드가 fail-open. 역시 좁히는 방향이라 보존 안전.
#     x-lively-mode 전파 완료 후 #1021 에서 dual-env·이 두 항목 함께 제거) +
#  브로커 config(#746 T4 — 소켓·member·workroot·툴목록·내부host·entry·per-broker 토큰. 전부 비밀 아님) +
#  CLAUDE_CODE_OAUTH_TOKEN(#1289 — 위탁 태스크의 자격 리스. 이 목록에서 **유일하게 비밀**이다. 보존하지 않으면
#   sudo env_reset 이 지워버려 하네스가 디스크 로그인 자격으로 조용히 폴백한다 → 등록한 계정이 아니라 박스에
#   /login 된 계정의 크레딧이 소모된다(무증상. 고객사 A에서 실제로 그랬다). 권한확대 아님: 값은 **의뢰자 본인의**
#   자격이고 강하 대상 uid 도 의뢰자 본인 박스유저다(/proc/<pid>/environ 은 그 uid·root 만 읽는다). 이 Cmnd 에만
#   걸린 보존이며, provision-member 의 LIVELY_TOKEN·브로커의 LIVELY_BROKER_AUTH 와 같은 선례다).
Defaults!/opt/lively/libexec/box-spawn env_keep += "CLAUDE_CODE_OAUTH_TOKEN TZ LIVELY_SESSION_ID LIVELY_MODE LIVELY_READONLY LIVELY_INCOGNITO LIVELY_OFF LIVELY_BROKER_SOCKET LIVELY_BROKER_MEMBER LIVELY_BROKER_WORKROOT LIVELY_BROKER_ALLOWED_TOOLS LIVELY_BROKER_INTERNAL_HOSTS LIVELY_BROKER_ENTRY LIVELY_BROKER_AUTH LIVELY_HOME LIVELY_APP_ID"

# ④ per-session cgroup 메모리 격리(#1059 D) — box-cgspawn 을 **root 로**. 세션(claude 등)은 네이티브 ELF 라
#   힙제한이 안 통해 메모리 캡 수단이 cgroup 뿐인데, 비-root 게이트웨이는 polkit 때문에 cgroup 을 못 만든다.
#   그래서 root 로 이 고정 wrapper 만 허용한다 — box-cgspawn 이 인자(osUser=box_/broker_·box_members 소속·메모리값·
#   '--'뒤 box-spawn 고정)를 엄격검증하고 `systemd-run --scope -- setpriv --reuid --init-groups` 로 **즉시 uid 강하**
#   하므로 root 상주가 아니다(box-cgspawn 헤더의 불변식 참조 — uid 강하를 systemd-run --uid 가 아니라 setpriv 로 하는
#   이유도 거기 있다). runas=(root) 인 이유: systemd-run 이 polkit 없이 scope(cgroup)를 만들려면 root 여야 한다.
#   env_keep: box-spawn 과 **동일 목록** — 이 첫 sudo(lively→box-cgspawn)에서 보존해야 systemd-run --scope 가
#   그 env 를 상속해 box-spawn 까지 TZ/LIVELY_SESSION_ID/LIVELY_MODE 등을 흘려보낸다(box-spawn 은 systemd-run 이
#   부르므로 box-spawn 자신의 env_keep 은 이 경로엔 안 걸린다 → 여기서 보존이 유일한 통로).
#   ⚠ 위 box-spawn env_keep 목록과 **항상 동일하게 유지**할 것 — 한쪽에만 변수를 추가하면 캡 세션(box-cgspawn 경유)과
#     비캡 세션(box-spawn 직행)의 env 가 갈린다(공유 상수·테스트로 강제하지 않으니 수기 동기화 규율).
Defaults!/opt/lively/libexec/box-cgspawn env_keep += "CLAUDE_CODE_OAUTH_TOKEN TZ LIVELY_SESSION_ID LIVELY_MODE LIVELY_READONLY LIVELY_INCOGNITO LIVELY_OFF LIVELY_BROKER_SOCKET LIVELY_BROKER_MEMBER LIVELY_BROKER_WORKROOT LIVELY_BROKER_ALLOWED_TOOLS LIVELY_BROKER_INTERNAL_HOSTS LIVELY_BROKER_ENTRY LIVELY_BROKER_AUTH LIVELY_HOME LIVELY_APP_ID"
lively ALL=(root) NOPASSWD: /opt/lively/libexec/box-cgspawn

# ② 웹 프로비저닝 — root 로 provision 스크립트 하나만. 토큰·이름·이메일만 env 보존(PATH 등은 미보존).
Defaults!/opt/lively/libexec/provision-member env_keep += "LIVELY_TOKEN MEMBER_NAME MEMBER_EMAIL LIVELY_SHARED_DIR"
lively ALL=(root) NOPASSWD: /opt/lively/libexec/provision-member
