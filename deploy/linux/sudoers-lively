# ─────────────────────────────────────────────────────────────────────────────
# 중앙 박스 구성원 격리(#524) — 게이트웨이 서비스 유저의 **최소** 권한 (2가지, 각각 root 소유 고정 스크립트만).
#
#  ① 세션 spawn: 세션 셸/하네스를 box_members 그룹의 그 멤버로 내림(자격증명 uid 격리의 핵심).
#  ② 웹 프로비저닝(#524): 관리자 버튼이 게이트웨이를 통해 멤버 OS 유저를 만든다(useradd 등 root 필요).
#
#  둘 다 **root 소유·게이트웨이 비쓰기 고정 스크립트**(/opt/lively/libexec/*)만 허용 — 게이트웨이가 스크립트를
#  못 고치므로 "그 스크립트가 하는 일" 외 임의 root 실행 불가. 토큰 등 비밀은 env_keep 으로만 전달(PATH 미보존
#  → secure_path 라 PATH 인젝션 없음). 멤버 추가는 box_members 그룹 가입만으로 되고 이 파일은 무수정.
#
#  ⚠ 설치(install-isolation.sh 가 수행): /etc/sudoers.d/lively (root:root 0440), `visudo -cf` 검증 후 활성.
#     'lively' 주체는 install-isolation.sh 가 실제 게이트웨이 유저로 치환(sed). box-spawn·provision-member 는
#     root:root 0755. box-spawn 헤더의 불변식 참조.
#  ⚠ ①=uid 격리, ②=웹 프로비저닝 편의. ssm-user NOPASSWD 회수·게이트웨이 docker 그룹 제거·전용 서비스 유저는
#     별도 하드닝 런북(P4).
# ─────────────────────────────────────────────────────────────────────────────

Runas_Alias LIVELY_BOX_MEMBERS = %box_members

# ① 세션 spawn — box_members 로 wrapper 하나만, 비밀번호 없이.
#  TZ 보존(#778): 게이트웨이가 tmux `-e TZ=<조직 시간대>` 로 pane 에 주입한 시간대를 sudo(env_reset)가 털지 않게
#   명시 보존한다 → 격리 세션의 클로드코드/셸이 UTC 가 아닌 조직 시간대로 시각을 표시한다. **권한 확대 아님**:
#   TZ 는 비밀이 아니고, 멤버는 자기 셸에서 어차피 TZ 를 바꿀 수 있다(sudo 는 이미 그 멤버 uid 로 내려간 뒤).
#   미적용(구 sudoers)이면 TZ 가 안 넘어가 시스템 TZ 폴백 = 종전 동작(무회귀).
Defaults!/opt/lively/libexec/box-spawn env_keep += "TZ"
lively ALL=(LIVELY_BOX_MEMBERS) NOPASSWD: /opt/lively/libexec/box-spawn

# ② 웹 프로비저닝 — root 로 provision 스크립트 하나만. 토큰·이름·이메일만 env 보존(PATH 등은 미보존).
Defaults!/opt/lively/libexec/provision-member env_keep += "LIVELY_TOKEN MEMBER_NAME MEMBER_EMAIL LIVELY_SHARED_DIR"
lively ALL=(root) NOPASSWD: /opt/lively/libexec/provision-member
