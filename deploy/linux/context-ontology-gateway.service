[Unit]
Description=context-ontology gateway (MCP + web UI + central-box runner)
Documentation=file://@APP_DIR@/deploy/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# ⚠ KillMode=process — 중앙박스 세션은 게이트웨이(node)가 spawn 한 tmux 서버가 붙든다. 기본값(control-group)이면
#   systemctl restart/stop 이 서비스 cgroup 전체(=tmux 서버까지) SIGTERM → 모든 웹터미널 세션이 죽는다.
#   process 로 main PID(게이트웨이)만 재시작하고 tmux 는 살려, 재시작 뒤 tmux 에서 세션을 그대로 re-attach 한다.
#   (설계 불변식: persistent tmux · 재기동 생존 — src/terminal-sessions.ts 메타를 tmux user-option 에 저장.)
KillMode=process
User=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=@NODE_BIN@ --env-file-if-exists=.env dist/index.js
Restart=always
RestartSec=10
LimitNOFILE=8192
# ⚠ UTF-8 로케일 불변식 — 없으면 tmux 가 list-sessions 출력의 탭·한글을 '_' 로 치환 → 웹터미널 입장 불가.
#   코드(src/terminal-sessions.ts)에서도 강제하지만 게이트웨이 전체 안전을 위해 여기서도 박는다.
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=LC_CTYPE=C.UTF-8
# 터미널 세션이 spawn 하는 claude/codex/git/tmux 를 찾도록 넉넉한 PATH(install-linux 가 치환).
Environment=PATH=@PATH@
# 로그 = 리포 내 내구 위치(+ journald). /tmp 금지(재부팅 증발).
StandardOutput=append:@APP_DIR@/logs/gateway.log
StandardError=append:@APP_DIR@/logs/gateway.log

[Install]
WantedBy=multi-user.target
