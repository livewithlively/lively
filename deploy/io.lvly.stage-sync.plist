<?xml version="1.0" encoding="UTF-8"?>
<!--
  io.lvly.stage-sync — dev 서빙 클론이 origin/stage 를 따라가게 한다(당기기만, 2026-08-26).
  설치:  cp deploy/io.lvly.stage-sync.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.lvly.stage-sync.plist
  제거:  launchctl bootout gui/$(id -u)/io.lvly.stage-sync
  ⚠ plist 를 고쳤으면 bootout → bootstrap (kickstart 는 plist 를 다시 읽지 않는다).

  60초 간격인 이유: "작은 화면 변경은 프리뷰를 건너뛰고 dev 로 바로"(원준 2026-08-21)라는 규칙의
   체감 속도를 죽이지 않기 위해서다. 이 스크립트는 깨끗할 때만 ff 하므로 빈 판에는 즉시 끝난다.
  KeepAlive 를 쓰지 않는다 — 이건 상주 프로세스가 아니라 주기 작업이다(StartInterval).
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.lvly.stage-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/lively/.openclaw/workspace/productivity/lively/scripts/serve-sync.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/lively/.openclaw/workspace/productivity/lively</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- tmux 가 탭 구분자·한글을 '_' 로 치우지 않게(#633 과 같은 이유) — 이 잡도 git·npm 을 부른다. -->
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>LC_ALL</key><string>en_US.UTF-8</string>
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/lively/.openclaw/workspace/productivity/lively/logs/stage-sync.out</string>
  <key>StandardErrorPath</key><string>/Users/lively/.openclaw/workspace/productivity/lively/logs/stage-sync.err</string>
</dict>
</plist>
