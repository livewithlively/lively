# Lively 배포 .env — 예시(시크릿 없음). 실제 .env 는 deploy/install.sh 가 자동 생성한다.
#  이 파일은 "무엇이 들어가는지" 문서용. 수동 설치 시 복사해 값을 채워도 된다(cp deploy/env.example .env).
#  ⚠ .env 는 .gitignore 등재 — 커밋 금지.

PORT=8080
#BIND_HOST=0.0.0.0                          # 바인드 주소(#250). 방화벽 계층 없는 호스트(사무실 mac 등)는 127.0.0.1 로 좁히고 tailscale serve 등으로 노출한다.
LOG_LEVEL=info
PUBLIC_URL=http://localhost:8080            # 외부 접속 URL(EC2 면 http://<EIP>:8080). LIVELY_DOMAIN 설정 시 https://도메인 로.
#LIVELY_ASSET_AUTO_RELOAD=1                  # 자산이 갱신되면 열려 있는 화면을 **말없이 다시 싣는다**(#2126).
#  기본(비움)은 알림 — 화면 위에 "새 버전이 나왔습니다 [새로고침]" 배너만 띄우고 사람이 누를 때 싣는다.
#  릴리스가 하필 글 쓰던 사람의 입력을 날리지 않게 하려는 것이라, **고객사 박스는 비워 둔다**.
#  켜는 곳은 dev 박스 하나다 — serve-sync 가 60초마다 stage 를 당겨 자산이 수시로 바뀌므로(io.lvly.stage-sync)
#  매번 배너를 누르는 건 개발 체감 속도를 죽인다. 켜도 사람이 입력 중이면 그때는 배너로 미룬다(web/gen-watch.ts).

# ── TLS 프론트도어(Caddy, profile=proxy) — 설정 시 자동 HTTPS(Let's Encrypt) ──
#  비우면 프록시 없음(8080 직접/SSH 터널). 설정 시 A레코드가 이 호스트를 향해야 인증서 발급. install.sh/update.sh 의 proxy_up 이 기동.
LIVELY_DOMAIN=                              # 예: gw.org.com (비우면 TLS 프록시 off)
LIVELY_UPSTREAM=localhost:8080             # Caddy → 게이트웨이(네이티브) 업스트림

# ── store(pgvector, docker compose) ── PGPASSWORD 는 openssl rand -hex 16 같은 고엔트로피로.
PGUSER=lively
PGPASSWORD=__hex__
PGDATABASE=items
ITEMS_DB_PORT=5432
ITEMS_DATABASE_URL=postgres://lively:__hex__@localhost:5432/items
# db_query 용 고객 제품 DB 는 웹UI(org_db_source, 읽기전용 리플리카)로 등록 — DATABASE_URL env 자동등록은 폐기.

# ── 에이전트/MCP bearer 토큰(정적) ── openssl rand -hex 32. admin/runtime 불가(kill-switch). 사람=세션 로그인.
AUTH_TOKENS_JSON='{"__hex64__":{"userId":"agent","email":"agent@example.com","scopes":["context","items","db","memory"],"projects":["*"]}}'
WEBHOOK_SECRET=__hex__
# ── secret-box 마스터키 — git 자격(#540)·커넥터 토큰(#541) at-rest 암호화 공용 ── openssl rand -hex 32.
#  install/update 가 자동 생성·보존(수동 불요). ⚠ 바꾸면 기존 암호문 복호 불가(재입력) → 백업·롤아웃 시 보존.
CONNECTOR_SECRET_KEY=__hex__

# ── 로케일(불변식: tmux 세션 파싱) ── Linux=C.UTF-8, mac=en_US.UTF-8
LANG=C.UTF-8
LC_ALL=C.UTF-8
LC_CTYPE=C.UTF-8

# ── 중앙박스(웹터미널) ──
TMUX_BIN=/usr/bin/tmux                       # mac: /opt/homebrew/bin/tmux
TERMINAL_ROOT_SHARED=/opt/lively/workspace
TERMINAL_ROOT_PERSONAL=/home/lively/box
TERMINAL_ROOT_APPS=/opt/lively/apps          # 앱 폴더 자리(#4673 — apps/<앱>/). Linux 설치는 설치 스크립트가 LIVELY_APPS_DIR 로 맞춘다
# LIVELY_APPS_DIR=/srv/lively/apps           # 멤버 격리 설치의 앱 폴더 자리(install-isolation.sh 가 만든다 · 기본값) — 위 값과 같은 곳이어야 한다
# LIVELY_AGENT_JOBS=host                     # 앱 AI 에이전트 작업(claude -p)을 이 박스의 tmux 에 띄운다(#5082) — 비우면 끔(앱의 에이전트 실행은 501).
#                                            #  격리 박스면 실행 계정 구성원의 box_ 계정으로 돈다(그 계정에 claude 설치 · 로그인 필요). 정확히 host 만 켠다.
#                                            #  ⚠ 격리가 꺼진 박스(LIVELY_MEMBER_ISOLATION=off · 격리 미설치)면 게이트웨이 계정으로 돈다 — 앱이 시킨 지시가
#                                            #   게이트웨이 권한(.env · DB)으로 돈다(사람 세션도 같다). 관리 도구 agent_job_limits 의 surface.runs_as 로 본다.
#                                            #  작업당 메모리 상한은 관리 도구 agent_job_limits_set memory_max_mb(기본 3072MB · box-cgspawn 필요) —
#                                            #   격리 박스에서 걸 수 없으면 작업을 띄우지 않는다(0 이면 상한 없이).
# LIVELY_AGENT_JOBS_PORT=8080                # 그 판이 부를 이 박스 게이트웨이 루프백 포트 — 청/녹 설치는 8080(고정 진입점) 그대로 둔다

# ── 임베딩 / 벡터검색(#172) — 기본 off(grep 폴백). 4GB 박스는 로컬 사이드카 비권장(t4g.large+). ──
#  뒤늦게 켜기(기존 박스): bash deploy/enable-embeddings.sh (사이드카→provider=http→재시작→기존 지식 백필).
#    외부 엔드포인트: EMBEDDINGS_BASE_URL=<host> EMBEDDINGS_MODEL=<m> [EMBEDDINGS_AUTH_ENV=<키담은env이름>] \
#      bash deploy/enable-embeddings.sh --external
#  또는 관리탭 '임베딩(벡터검색)'에서 토글+백필(무재시작). 설치 시 처음부터: WITH_EMBEDDINGS=1 bash deploy/install.sh.
EMBEDDINGS_PROVIDER=off
EMBEDDINGS_BASE_URL=http://localhost:11434
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_DIMENSIONS=1024
# EMBEDDINGS_AUTH_ENV=OPENAI_API_KEY   # 외부 API 인증 시: 키를 담은 환경변수 '이름'(값 아님)

# ── 앱 서버(web.server) — 자가호스팅(#4487 앱 v2-8). 비우면 앱 서버 꺼짐(화면 · 표는 그대로 된다) ──
#  local = 이 박스의 Docker 로 돌린다(앱 × 판 = 컨테이너 하나 · 한가하면 재우고 부르면 깨운다). 게이트웨이 계정이 docker 그룹이어야 한다.
#  ⚠ docker 그룹은 사실상 root 다 — 켜기 전에 이 박스가 그래도 되는지 본다. 컨테이너 인자는 검사기(ops/docker-run-guard)가 걸러 박스를 내주는 꼴을 막는다.
#  빌드는 자격 없는 일회용 컨테이너에서(npm 레지스트리로 나가기 필요) · 앱 서버도 바깥 API 를 부를 수 있다.
#  재우기 기본(idle_sleep_min · 10분) · 워크스페이스 메모리 예산(local_memory_mb · 2048)은 관리자가 app_server_limits_set 으로, 앱별 재우기는 app_server_idle_set.
# LIVELY_APP_SERVER_HOST=local
# LIVELY_APP_SERVER_API_URL=http://host.docker.internal:8080   # 컨테이너가 게이트웨이를 부를 주소(비우면 조직 게이트웨이 주소 → PUBLIC_URL)
# LIVELY_APP_SERVER_IMAGE=node:22-bookworm-slim                # 실행 · 빌드 이미지(바꾸면 다음 배포가 다시 빌드한다)
# LIVELY_APP_SERVER_LOCAL_MEMORY_MAX_MB=                       # 박스 천장 — 깨어 있는 앱 서버 메모리 합(비우면 Docker 메모리의 50%)
# LIVELY_APP_SERVER_LOCAL_DIR=                                 # 판 · zip 자리(비우면 <상태 폴더>/app-servers)
# LIVELY_APP_SERVER_NETWORK=lvly-apps                          # 앱 서버 전용 브리지(컨테이너 사이 통신 끔 — 켜진 채면 쓰지 않는다)
# LIVELY_APP_SERVER_BUILD_CONCURRENCY=1                        # 박스에서 동시에 도는 빌드 수(1~8)
# LIVELY_APP_SERVER_BUILD_MEMORY_MB=2048                       # 빌드 컨테이너 메모리
# LIVELY_DOCKER_BIN=docker                                     # docker CLI 자리

# ── db_query 안전장치 ──
DB_STATEMENT_TIMEOUT_MS=5000
DB_MAX_ROWS=1000

# ── 회사 계정으로 웹 로그인(OIDC, #1520 — 선택. 비우면 이메일+비밀번호만) ──────
#  조직이 구글 워크스페이스·Azure AD·Okta 를 쓰면 그 계정으로 게이트웨이 웹에 로그인시킨다.
#  ⚠ 이걸 켜도 이메일+비밀번호 로그인은 그대로 남는다(IdP 장애·에어갭 배포의 폴백) — 관리자 락아웃 방지.
#  ⚠ PUBLIC_URL(또는 관리탭 조직 프로필의 게이트웨이 주소)이 **실제 접속 주소와 같아야** 한다.
#    콜백 주소를 거기서 만들기 때문이다 → 다르면 IdP 가 redirect_uri 불일치로 거절한다.
#
#  IdP 콘솔에서 할 일(사람):
#   1) 웹 애플리케이션 OAuth 클라이언트 생성
#   2) 승인된 리디렉션 URI 에 정확히 이 값 등록:  <PUBLIC_URL>/api/ui/auth/oidc/callback
#      (예: https://gw.honest.ai/api/ui/auth/oidc/callback — 끝의 슬래시·대소문자까지 정확히)
#   3) 발급된 client id/secret 을 아래에 넣고 재시작
#
#  구글 워크스페이스: OIDC_ISSUER=https://accounts.google.com
#  Azure AD:        https://login.microsoftonline.com/<tenant-id>/v2.0
#  Okta:            https://<your-org>.okta.com
OIDC_ISSUER=                                 # 비우면 OIDC 로그인 off
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
#  자동 가입 허용 도메인(콤마) — 이 도메인의 **검증된** 회사 이메일이면 첫 로그인에 구성원이 자동 생성된다.
#   부여 권한은 items·context·memory 뿐(관리자·런타임·DB·코드 권한은 사람이 관리탭에서 올린다).
#   비우면 자동 가입 없음 = 관리탭에 미리 등록된 구성원만 로그인할 수 있다.
OIDC_ALLOWED_DOMAINS=                        # 예: honest.ai
# OIDC_LABEL=Google 계정으로 로그인           # 로그인 버튼 문구(기본: issuer 로 추정)
# OIDC_TRUST_UNVERIFIED_EMAIL=1              # ⚠ IdP 가 email_verified 를 아예 안 줄 때만. 기본(미설정)은 거부.
#  로그아웃하면 IdP 세션도 끝내기(RP-Initiated Logout) — 기본 꺼짐. 켜면 같은 IdP 로 로그인한 다른 앱에서도 나간다.
#   IdP 가 로그아웃 주소(end_session_endpoint)를 줄 때만 동작한다(구글 워크스페이스는 안 준다 → 켜도 웹 세션만 끝남).
#   ⚠ 켜기 전에 IdP 콘솔에서 «로그아웃 후 이동 주소(post logout redirect URI)» 허용 목록에 정확히 등록:
#      <PUBLIC_URL>/ui/       (예: https://gw.honest.ai/ui/ — 끝 슬래시까지. 안 하면 로그아웃 때 IdP 오류 화면)
# OIDC_IDP_LOGOUT=1
