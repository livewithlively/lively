<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 템플릿: deploy/mac/provision.sh 가 @APP_DIR@/@NODE_BIN@/@PATH@ 치환 후 ~/Library/LaunchAgents/ 에 설치. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.lvly.lively</string>

  <key>ProgramArguments</key>
  <array>
    <string>@NODE_BIN@</string>
    <string>--env-file-if-exists=.env</string>
    <string>dist/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@APP_DIR@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- 터미널 세션이 spawn 하는 claude/codex/bash/git PATH. -->
    <key>PATH</key>
    <string>@PATH@</string>
    <!-- ⚠ UTF-8 로케일 필수 — 없으면 tmux 세션 파싱이 깨져 웹터미널 입장 불가. -->
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>LC_ALL</key>
    <string>en_US.UTF-8</string>
    <key>LC_CTYPE</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- 어떻게 죽든(정상종료 exit 0 포함) 자동 재시작 = "최대한 안 죽게"의 핵심.
       ⚠ 종전 KeepAlive{SuccessfulExit:false} 는 **비정상 종료에만** 재기동했다 — 게이트웨이는 SIGTERM 을 우아하게
       받아 exit 0 으로 끝나므로 남의 `pkill -f dist/index.js`·`kill`·`launchctl stop` 한 방에 영구 다운됐다
       (2026-08-26 dev.lvly.io 9분 502). 코드도 exit 0 = "슈퍼바이저가 다시 띄운다"를 전제한다
       (src/boot/housekeeping.ts workspace-registry 의 의도된 재기동 · Linux 유닛은 Restart=always). 내리려면 bootout.
       회귀 가드: deploy/mac/keepalive-always.test.mjs -->
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>@APP_DIR@/logs/gateway.log</string>
  <key>StandardErrorPath</key>
  <string>@APP_DIR@/logs/gateway.log</string>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>
</dict>
</plist>
