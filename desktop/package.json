{
  "name": "lively-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "라이블리 데스크톱 — 설치·로그인·노드 등록을 GUI 로 (트레이 상주)",
  "type": "module",
  "main": "main/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dist": "npm run icon && electron-builder --publish never",
    "dist:mac": "npm run icon && electron-builder --mac --publish never",
    "dist:win": "npm run icon && electron-builder --win --publish never",
    "icon": "node tools-gen-icon.mjs"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.lvly.desktop",
    "productName": "Lively",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "assets/**/*",
      "LICENSE",
      "!**/*.test.mjs"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signtoolOptions": {}
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "livewithlively",
        "repo": "lively"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
