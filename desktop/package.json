{
  "name": "lively-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "라이블리 데스크톱 — 설치·로그인·노드 등록을 GUI 로 (트레이 상주)",
  "type": "module",
  "main": "main/main.mjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.lvly.desktop",
    "productName": "Lively",
    "directories": { "output": "release" },
    "files": ["main/**/*", "preload/**/*", "renderer/**/*", "assets/**/*", "!**/*.test.mjs"],
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"], "category": "Development" }
  }
}
