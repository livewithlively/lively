{
  "name": "context-ontology",
  "version": "0.1.0",
  "private": true,
  "description": "Lively 통합 컨텍스트 스토어 — 사내 MCP 게이트웨이 (memory/context/code/db)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node dist/db/sources.test.js && node dist/db/source-guard.test.js && node dist/db/firewall.test.js && node dist/tools/db.test.js && node dist/items/mapping-extract.test.js && node dist/domainmap/core/refresh-fs.test.js",
    "parity": "npm run build && node --env-file-if-exists=.env scripts/parity-check.mjs",
    "dm": "node --env-file-if-exists=.env dist/domainmap/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.0",
    "express": "^4.19.2",
    "node-sql-parser": "^5.3.0",
    "pg": "^8.13.1",
    "pg-connection-string": "^2.13.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
